<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>JARVIS AI Assistant</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#07111c;color:#00e5ff;font-family:Arial,sans-serif;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px}
.app{width:100%;max-width:420px;text-align:center;border:1px solid #00e5ff;border-radius:22px;padding:24px;box-shadow:0 0 25px #00e5ff33}
h1{letter-spacing:5px;text-shadow:0 0 15px #00e5ff}
.circle{width:150px;height:150px;border:3px solid #00e5ff;border-radius:50%;margin:25px auto;display:flex;align-items:center;justify-content:center;font-size:48px;box-shadow:0 0 30px #00e5ff55}
p{color:#b8dce5}
input{width:100%;padding:14px;border-radius:10px;border:1px solid #00e5ff;background:#10212e;color:white;font-size:16px}
button{padding:13px 18px;margin:7px 3px;border:1px solid #00e5ff;border-radius:10px;background:#003746;color:white;font-size:15px}
#reply{margin-top:20px;color:white;overflow-wrap:anywhere}
</style>
</head>
<body>
<div class="app">
<h1>J.A.R.V.I.S</h1>
<p>PERSONAL AI ASSISTANT</p>
<div class="circle">◉</div>
<p id="status">SYSTEM ONLINE</p>
<input id="command" placeholder="Type a command...">
<br>
<button onclick="runCommand()">RUN COMMAND</button>
<button onclick="listen()">🎙 SPEAK</button>
<div id="reply">Hello! I am your JARVIS interface.</div>
</div>
<script>
function speak(text){
 document.getElementById('reply').textContent=text;
 if('speechSynthesis' in window){
  speechSynthesis.cancel();
  let msg=new SpeechSynthesisUtterance(text);
  msg.lang='hi-IN';
  speechSynthesis.speak(msg);
 }
}
function runCommand(){
 let input=document.getElementById('command');
 let q=input.value.trim();
 if(!q){speak('Please enter a command.');return;}
 let cmd=q.toLowerCase();
 if(cmd.includes('youtube')){
  speak('Opening YouTube');
  window.open('https://m.youtube.com','_blank');
 }else if(cmd.includes('time')||cmd.includes('समय')){
  speak('Current time is '+new Date().toLocaleTimeString());
 }else if(cmd.includes('hello')||cmd.includes('नमस्ते')){
  speak('Hello! JARVIS is online.');
 }else{
  speak('I received your command: '+q+'. Connect an AI API to enable intelligent answers.');
 }
}
function listen(){
 const SpeechRecognition=window.SpeechRecognition||window.webkitSpeechRecognition;
 if(!SpeechRecognition){speak('Voice recognition is not supported in this browser. Please type your command.');return;}
 const recognition=new SpeechRecognition();
 recognition.lang='hi-IN';
 recognition.onstart=()=>document.getElementById('status').textContent='LISTENING...';
 recognition.onresult=e=>{
  document.getElementById('command').value=e.results[0][0].transcript;
  runCommand();
 };
 recognition.onerror=()=>document.getElementById('status').textContent='VOICE ERROR';
 recognition.onend=()=>document.getElementById('status').textContent='SYSTEM ONLINE';
 recognition.start();
}
document.getElementById('command').addEventListener('keydown',e=>{if(e.key==='Enter')runCommand()});
</script>
</body>
</html>
